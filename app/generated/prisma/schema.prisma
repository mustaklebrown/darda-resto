generator client {
  provider = "prisma-client-js"
}

generator dev {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model CategoryPlate {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  plates    Plate[]
  menus     Menu[]
}

model CategoryMenu {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  menus     Menu[]
}

model Feedback {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  plateId   String
  userName  String?
  userEmail String?
  createdAt DateTime @default(now())
  plate     Plate    @relation(fields: [plateId], references: [id], onDelete: Cascade)
}

model Menu {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  image          String?
  type           MenuType        @default(REGULAR)
  isFeatured     Boolean         @default(false)
  isActive       Boolean         @default(true)
  startTime      DateTime?
  endTime        DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  categoryMenuId String?
  categoryMenu   CategoryMenu?   @relation(fields: [categoryMenuId], references: [id])
  categoryPlates CategoryPlate[]
  plates         Plate[]
}

model Plate {
  id            String        @id @default(cuid())
  name          String
  description   String
  price         Float
  image         String?
  categoryId    String
  createdAt     DateTime      @default(now())
  isAvailable   Boolean       @default(true)
  slug          String?       @unique
  feedback      Feedback[]
  categoryPlate CategoryPlate @relation(fields: [categoryId], references: [id])
  menus         Menu[]
}

model Reservation {
  id        String            @id @default(cuid())
  name      String
  email     String
  phone     String
  date      DateTime
  guests    Int
  message   String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model user {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  account       account[]
  session       session[]
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum MenuType {
  DAILY
  TIME_BASED
  SEASONAL
  REGULAR
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
