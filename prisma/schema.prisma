generator client {
  provider = "prisma-client-js"
}

generator dev {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String   @id
  name      String
  slug      String   @unique
  image     String?
  createdAt DateTime @default(now())
  plates    Plate[]
  menus     Menu[]
}

model Feedback {
  id        String   @id
  rating    Int
  comment   String?
  plateId   String
  userName  String?
  userEmail String?
  createdAt DateTime @default(now())
  plate     Plate    @relation(fields: [plateId], references: [id], onDelete: Cascade)
}

model Menu {
  id          String     @id
  name        String
  slug        String     @unique
  description String?
  image       String?
  type        MenuType   @default(REGULAR)
  isFeatured  Boolean    @default(false)
  isActive    Boolean    @default(true)
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  categories  Category[]
  plates      Plate[]
}

model Plate {
  id          String     @id
  name        String
  description String
  price       Float
  image       String?
  categoryId  String
  createdAt   DateTime   @default(now())
  isAvailable Boolean    @default(true)
  slug        String?    @unique
  feedback    Feedback[]
  category    Category   @relation(fields: [categoryId], references: [id])
  menus       Menu[]
}

model Reservation {
  id        String            @id
  name      String
  email     String
  phone     String
  date      DateTime
  guests    Int
  message   String?
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?
  account       account[]
  session       session[]
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([identifier])
}

enum MenuType {
  DAILY
  TIME_BASED
  SEASONAL
  REGULAR
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
